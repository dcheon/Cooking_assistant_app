  {
    "id": "recipe-002",
    "title": "계란말이",
    "description": "폭신하고 고소한 일본식 계란말이. 도시락 반찬으로도 완벽.",
    "ingredients": ["달걀 3개", "당근 1/4개", "파 1/4대", "소금 약간", "식용유 1작은술"],
    "steps": [
      { "id": "s002-1", "order": 1, "instruction": "달걀 3개를 풀고 소금을 약간 넣어 잘 섞어주세요." },
      { "id": "s002-2", "order": 2, "instruction": "당근과 파를 잘게 썰어 달걀물에 넣어주세요." },
      { "id": "s002-3", "order": 3, "instruction": "팬에 식용유를 살짝 두르고 중약불로 달궈주세요." },
      { "id": "s002-4", "order": 4, "instruction": "달걀물 절반을 붓고 반쯤 익으면 천천히 한쪽에서 말아주세요." },
      { "id": "s002-5", "order": 5, "instruction": "남은 달걀물을 붓고 앞에 만 것과 함께 다시 말아주세요." },
      { "id": "s002-6", "order": 6, "instruction": "약불에서 2분 더 익힌 뒤 꺼내 한 김 식히면 완성입니다." }
    ],
