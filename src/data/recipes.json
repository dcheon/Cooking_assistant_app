  {
    "id": "recipe-001",
    "title": "김치볶음밥",
    "description": "고소하고 매콤한 한국식 볶음밥. 남은 밥과 김치로 5분 만에 완성.",
    "ingredients": ["밥 1공기", "묵은 김치 1/2컵", "식용유 1큰술", "간장 1큰술", "참기름 1작은술", "달걀 1개"],
    "steps": [
      { "id": "s001-1", "order": 1, "instruction": "팬에 식용유를 두르고 중불로 가열하세요." },
      { "id": "s001-2", "order": 2, "instruction": "김치를 넣고 2분간 볶아주세요." },
      { "id": "s001-3", "order": 3, "instruction": "밥을 넣고 김치와 잘 섞으며 볶아주세요." },
      { "id": "s001-4", "order": 4, "instruction": "간장과 참기름을 넣고 1분 더 볶아주세요." },
      { "id": "s001-5", "order": 5, "instruction": "달걀 프라이를 위에 올리면 완성입니다." }
    ],
